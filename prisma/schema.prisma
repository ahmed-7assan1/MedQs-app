generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteConfig {
  id                   String   @id @default(uuid())
  siteName             String   @default("MedOneX")
  logoUrl              String?
  faviconUrl           String?
  primaryColor         String   @default("#0d9488")
  enableAI             Boolean  @default(true)
  enableForum          Boolean  @default(true)
  enableAds            Boolean  @default(true)
  enableNotifs         Boolean  @default(true)
  enableLeaderboard    Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  fontArabic           String?
  fontSans             String?
  aiPreferredProvider  String   @default("auto")
  /// Square icon for PWA “Add to Home Screen” / maskable (512×512). Falls back to faviconUrl then defaults.
  pwaIconUrl           String?
  logoUrlDark          String?
  facebookUrl          String?
  hulkLogoUrl          String?
  instagramUrl         String?
  telegramUrl          String?
  twitterUrl           String?
  whatsappUrl          String?
  youtubeUrl           String?
  enableCreativeStudio Boolean  @default(false)
  stabilityAIKey       String?
  assemblyAIKey        String?
  uploadcarePublicKey  String?
}

model FeatureFlag {
  id           String      @id @default(uuid())
  key          String
  enabled      Boolean     @default(false)
  payload      Json?
  universityId String?
  updatedAt    DateTime    @updatedAt
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, key])
  @@index([key])
}

model University {
  id             String                   @id @default(uuid())
  name           String
  abbr           String?
  logoUrl        String?
  idMinLength    Int                      @default(6)
  idMaxLength    Int                      @default(10)
  createdAt      DateTime                 @default(now())
  academicYears  AcademicYear[]
  adBanners      AdBanner[]
  comments       Comment[]
  faculties      Faculty[]
  featureFlags   FeatureFlag[]
  forums         Forum[]
  guestQuizUsers GuestQuizUser[]
  posts          Post[]
  yearIdFormats  UniversityYearIdFormat[]
  users          User[]
  medicalTeams   MedicalTeam[]
  studyRooms     StudyRoom[]
}

/// Faculty (كليه) — optional sub-division of a University.
/// When present, AcademicYears are grouped under a Faculty.
/// If a University has no Faculties, the old flat structure is preserved (facultyId = null).
model Faculty {
  id             String          @id @default(uuid())
  name           String
  logoUrl        String?
  universityId   String
  createdAt      DateTime        @default(now())
  category       FacultyCategory @default(OTHER)
  academicYears  AcademicYear[]
  university     University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  guestQuizUsers GuestQuizUser[]
  sourceBooks    SourceBook[]
  users          User[]
  medicalTeams   MedicalTeam[]

  @@index([universityId])
  @@index([category])
}

model UniversityYearIdFormat {
  id           String     @id @default(uuid())
  universityId String
  yearNumber   Int
  minLength    Int        @default(6)
  maxLength    Int        @default(10)
  prefix       String?
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, yearNumber])
}

model AcademicYear {
  id           String     @id @default(uuid())
  yearNumber   Int
  universityId String
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id])
  university   University @relation(fields: [universityId], references: [id])
  semesters    Semester[]

  @@unique([universityId, yearNumber, facultyId])
  @@index([facultyId])
}

model Semester {
  id             String             @id @default(uuid())
  name           String
  academicYearId String
  adBanners      AdBanner[]
  forums         Forum[]
  guestQuizUsers GuestQuizUser[]
  modules        Module[]
  pastPapers     PastPaper[]
  playlistSyncs  PlaylistSyncTask[]
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id])
  subjects       Subject[]
  users          User[]
}

model PlaylistSyncTask {
  id          String   @id @default(uuid())
  playlistUrl String
  semesterId  String
  mediaType   String
  editionYear String?
  lastSynced  DateTime @default(now())
  createdAt   DateTime @default(now())
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

model Module {
  id         String      @id @default(uuid())
  name       String
  icon       String?
  semesterId String
  semester   Semester    @relation(fields: [semesterId], references: [id])
  pastPapers PastPaper[]
  subjects   Subject[]
}

model Subject {
  id               String    @id @default(uuid())
  name             String
  icon             String?
  moduleId         String?
  isQuizSystemBank Boolean   @default(false)
  semesterId       String?
  lectures         Lecture[]
  module           Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  semester         Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([moduleId, isQuizSystemBank])
  @@index([semesterId])
}

model Lecture {
  id            String                @id @default(uuid())
  title         String
  videoUrl      String?
  order         Int                   @default(0)
  subjectId     String
  notesMarkdown String?
  extras        Json?
  uiConfig      Json?
  flashcards    Flashcard[]
  subject       Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  files         LectureFile[]
  records       LectureRecord[]
  videos        LectureVideo[]
  PastPaper     PastPaper?
  questions     Question[]
  activities    UserLectureActivity[]
  notes         Note[]
  teamId        String?
  team          MedicalTeam?          @relation(fields: [teamId], references: [id])
  type          LectureType           @default(LECTURE)
  checklist     Checklist?
}

enum LectureType {
  LECTURE
  PRACTICAL
}

model Checklist {
  id        String          @id @default(uuid())
  title     String
  lectureId String          @unique
  lecture   Lecture         @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(uuid())
  content     String
  points      Int       @default(1)
  isCritical  Boolean   @default(false)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id        String  @id @default(uuid())
  front     String
  back      String
  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model LectureFile {
  id                String  @id @default(uuid())
  name              String
  url               String
  mimeType          String
  lectureId         String
  telegramMessageId Int?
  telegramChatId    String?
  telegramFileId    String?
  shouldBroadcast   Boolean @default(true)
  isBroadcasted     Boolean @default(false)
  lecture           Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model LectureVideo {
  id             String                @id @default(uuid())
  title          String
  url            String
  sourceType     String                @default("external")
  sharingEnabled Boolean               @default(true)
  likesCount     Int                   @default(0)
  commentsCount  Int                   @default(0)
  sharesCount    Int                   @default(0)
  sortOrder      Int                   @default(0)
  lectureId      String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lecture           Lecture               @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  telegramMessageId Int?
  telegramChatId    String?
  telegramFileId    String?
  shouldBroadcast   Boolean @default(true)
  isBroadcasted     Boolean @default(false)
  comments          LectureVideoComment[]
  likes          LectureVideoLike[]

  @@index([lectureId, sortOrder])
}

model LectureRecord {
  id             String   @id @default(uuid())
  title          String
  url            String
  sourceType     String   @default("spotify")
  lectureId      String
  createdAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lecture           Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  telegramMessageId Int?
  telegramChatId    String?

  @@index([lectureId])
}

model LectureVideoComment {
  id        String                @id @default(uuid())
  content   String
  videoId   String
  userId    String
  createdAt DateTime              @default(now())
  parentId  String?
  parent    LectureVideoComment?  @relation("VideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LectureVideoComment[] @relation("VideoCommentReplies")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     LectureVideo          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId])
}

model LectureVideoLike {
  id      String       @id @default(uuid())
  videoId String
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   LectureVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
}

model Question {
  id             String             @id @default(uuid())
  body           String
  choices        Json
  answer         String
  explanation    String?
  aiExplanation  String?
  difficulty     Difficulty         @default(MEDIUM)
  lectureId      String
  createdAt      DateTime           @default(now())
  imageUrl       String?
  stemLayout     QuestionStemLayout @default(STANDARD)
  essayReference String?
  questionType   String             @default("MCQ")
  lecture        Lecture            @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  reports        QuestionReport[]
  attemptItems   QuizAttemptItem[]
  savedBy        SavedQuestion[]
  sharedInPosts  Post[]
  telegramMessageId String?
  telegramChatId    String?
  videoUrl       String?
  videoSource    MediaSource        @default(YOUTUBE)
  stationTime    Int?               // Time in seconds for OSCE mode
  studyRoomPosts StudyRoomPost[]
}

enum MediaSource {
  YOUTUBE
  DRIVE
  TELEGRAM
  EXTERNAL
}

model PastPaper {
  id                      String           @id @default(uuid())
  title                   String
  pdfUrl                  String?
  isInteractive           Boolean          @default(false)
  timeLimitMin            Int?
  semesterId              String
  moduleId                String
  createdAt               DateTime         @default(now())
  aiExplanationEnabled    Boolean          @default(true)
  allowAiDuringQuiz       Boolean          @default(false)
  restrictCopyPaste       Boolean          @default(false)
  secureExamMode          Boolean          @default(false)
  trackFocusLoss          Boolean          @default(false)
  kind                    PastPaperKind    @default(MODULE_QUESTION_BANK)
  quizLectureId           String?          @unique
  googleSheetsSyncEnabled Boolean          @default(false)
  isPrivate               Boolean          @default(false)
  randomizeQuestions      Boolean          @default(false)
  module                  Module           @relation(fields: [moduleId], references: [id])
  quizLecture             Lecture?         @relation(fields: [quizLectureId], references: [id])
  semester                Semester         @relation(fields: [semesterId], references: [id])
  questionReports         QuestionReport[]
  attempts                QuizAttempt[]
}

model QuestionReport {
  id          String     @id @default(uuid())
  questionId  String
  userId      String
  note        String?
  pastPaperId String?
  createdAt   DateTime   @default(now())
  pastPaper   PastPaper? @relation(fields: [pastPaperId], references: [id])
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId, createdAt])
}

model SavedQuestion {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

model GuestQuizUser {
  id                String        @id @default(uuid())
  displayName       String
  externalStudentId String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  facultyId         String?
  semesterId        String?
  universityId      String?
  faculty           Faculty?      @relation(fields: [facultyId], references: [id])
  semester          Semester?     @relation(fields: [semesterId], references: [id])
  university        University?   @relation(fields: [universityId], references: [id])
  quizAttempts      QuizAttempt[]

  @@index([createdAt])
}

model QuizAttempt {
  id              String            @id @default(uuid())
  score           Int
  timeTaken       Int               @default(0)
  userId          String?
  pastPaperId     String
  createdAt       DateTime          @default(now())
  focusLossCount  Int               @default(0)
  guestQuizUserId String?
  guestQuizUser   GuestQuizUser?    @relation(fields: [guestQuizUserId], references: [id], onDelete: Cascade)
  pastPaper       PastPaper         @relation(fields: [pastPaperId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           QuizAttemptItem[]

  @@index([userId])
  @@index([guestQuizUserId])
  @@index([pastPaperId])
}

model StudyAssistantProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  scheduleText      String?
  hobbies           String?
  dailyStudyMinutes Int      @default(120)
  worshipMinutes    Int      @default(30)
  otherRoutines     String?
  currentPlanJson   Json?
  progressJson      Json?
  weekStartIso      String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizAttemptItem {
  id         String      @id @default(uuid())
  chosen     String?
  isCorrect  Boolean
  attemptId  String
  questionId String
  /// AI rubric for ESSAY: scorePercent, stagesMet/Total, feedback, stageNotes
  essayGrade Json?
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  nickname              String?
  email                 String                 @unique
  emailVerified         DateTime?
  image                 String?
  bio                   String?
  phone                 String?
  phoneVisible          Boolean                @default(false)
  hideRank              Boolean                @default(false)
  theme                 Theme                  @default(SYSTEM)
  role                  Role                   @default(STUDENT)
  points                Int                    @default(0)
  password              String?
  studentId             String?
  universityId          String?
  semesterId            String?
  rankId                String?
  studentCode           String?                @unique
  rolePermissions       Json?
  telegramPhone         String?                @unique
  isLeader              Boolean                @default(false)
  leaderId              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  facebookUrl           String?
  instagramUrl          String?
  isPrivate             Boolean                @default(false)
  canManageReports      Boolean                @default(false)
  facultyId             String?
  personalGeminiKey     String?
  handle                String?                @unique
  aiUsageLogs           AIUsageLog[]
  accounts              Account[]
  channelFollows        ChannelFollow[]
  comments              Comment[]
  commentLikes          CommentLike[]
  dmReceived            DirectMessage[]        @relation("DmReceived")
  dmSent                DirectMessage[]        @relation("DmSent")
  documentTemplates     DocumentTemplate[]
  engagementLogs        EngagementLog[]
  videoComments         LectureVideoComment[]
  videoLikes            LectureVideoLike[]
  likes                 Like[]
  notifications         Notification[]
  notifMutes            NotificationMute?
  posts                 Post[]
  receivedInvites       PrivateForumInvite[]   @relation("InviteReceiver")
  sentInvites           PrivateForumInvite[]   @relation("InviteSender")
  forumMemberships      PrivateForumMember[]
  questionReports       QuestionReport[]
  quizAttempts          QuizAttempt[]
  savedQuestions        SavedQuestion[]
  sessions              Session[]
  studyAssistantProfile StudyAssistantProfile?
  faculty               Faculty?               @relation(fields: [facultyId], references: [id])
  rank                  Rank?                  @relation(fields: [rankId], references: [id])
  semester              Semester?              @relation(fields: [semesterId], references: [id])
  university            University?            @relation(fields: [universityId], references: [id])
  following             UserFollow[]           @relation("UserFollows")
  followers             UserFollow[]           @relation("UserFollowers")
  lectureActivities     UserLectureActivity[]
  tasks                 UserTask[]
  notes                 Note[]
  teamMemberships       TeamMember[]
  followedTeams         TeamFollower[]
  telegramId           String?                @unique
  telegramVerified     Boolean                @default(false)
  coverImage           String?
  pushSubscriptions    PushSubscription[]
  pollVotes            PollVote[]
  ownedStudyRoom       StudyRoom?             @relation("RoomOwner")
  studyRoomMembers     StudyRoomMember[]
  studyRoomPosts       StudyRoomPost[]
  studyRoomComments    StudyRoomComment[]
  studyRoomPostLikes   StudyRoomPostLike[]
  savedPosts           SavedPost[]
  taskCompletions      StudyRoomTaskCompletion[]
}

model TelegramConfig {
  id               String   @id @default("global")
  welcomeMessage   String?  @db.Text
  broadcastMessage String?  @db.Text
  botStatus        String   @default("ACTIVE") // ACTIVE, MAINTENANCE
  defaultProvider  String   @default("gemini")
  defaultModel     String?
  updatedAt        DateTime @updatedAt
}

model BotAuth {
  id         String   @id @default(uuid())
  code       String   @unique
  telegramId String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  content   String   @db.Text
  lectureId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
}

model UserLectureActivity {
  id           String   @id @default(uuid())
  userId       String
  lectureId    String
  source       String?
  lastViewedAt DateTime @default(now())
  isCompleted  Boolean  @default(false)
  lecture      Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId, lastViewedAt])
  @@index([lectureId])
}

model DirectMessage {
  id         String   @id @default(uuid())
  body       String
  read       Boolean  @default(false)
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  receiver   User     @relation("DmReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("DmSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId, read])
  @@index([senderId, receiverId, createdAt])
}

model Forum {
  id           String               @id @default(uuid())
  name         String
  type         ForumType
  status       ForumStatus          @default(OPEN)
  semesterId   String?
  createdBy    String?
  createdAt    DateTime             @default(now())
  universityId String
  semester     Semester?            @relation(fields: [semesterId], references: [id])
  university   University           @relation(fields: [universityId], references: [id])
  posts        Post[]
  invites      PrivateForumInvite[]
  members      PrivateForumMember[]

  @@index([universityId, type, status])
}

model PrivateForumMember {
  id      String @id @default(uuid())
  forumId String
  userId  String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([forumId, userId])
}

model PrivateForumInvite {
  id         String   @id @default(uuid())
  forumId    String
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  forum      Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  receiver   User     @relation("InviteReceiver", fields: [receiverId], references: [id])
  sender     User     @relation("InviteSender", fields: [senderId], references: [id])

  @@unique([forumId, receiverId])
}

model Post {
  id                   String       @id @default(uuid())
  content              String
  imageUrl             String?
  telegramFileId       String?
  telegramChatId       String?
  telegramMessageId    String?
  attachments          Json?        // Array of { url: string, type: 'image' | 'file', fileId: string }
  interactionsDisabled Boolean      @default(false)
  authorId             String
  forumId              String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  audience             PostAudience @default(UNIVERSITY)
  universityId         String
  expiresAt            DateTime?
  isPinned             Boolean      @default(false)
  isChatMessage        Boolean      @default(false)
  isForumPost          Boolean      @default(true)
  comments             Comment[]
  likes                Like[]
  author               User         @relation(fields: [authorId], references: [id])
  forum                Forum        @relation(fields: [forumId], references: [id])
  university           University   @relation(fields: [universityId], references: [id])
  teamId               String?
  team                 MedicalTeam? @relation(fields: [teamId], references: [id])
  pollId               String?      @unique
  poll                 Poll?        @relation(fields: [pollId], references: [id])
  sharedQuestionId     String?
  sharedQuestion       Question?    @relation(fields: [sharedQuestionId], references: [id])
  sharedQuestionData   Json?
  hashtags             PostHashtag[]
  savedBy              SavedPost[]

  @@index([universityId, createdAt])
  @@index([forumId, createdAt])
  @@index([audience, createdAt])
}

model Comment {
  id           String        @id @default(uuid())
  content      String
  attachments  Json?
  authorId     String
  postId       String
  parentId     String?
  createdAt    DateTime      @default(now())
  universityId String
  author       User          @relation(fields: [authorId], references: [id])
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  university   University    @relation(fields: [universityId], references: [id])
  likes        CommentLike[]

  @@index([universityId, createdAt])
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model Like {
  id     String @id @default(uuid())
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model CommentLike {
  id        String  @id @default(uuid())
  userId    String
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
}

model Notification {
  id        String       @id @default(uuid())
  title     String
  body      String
  channel   NotifChannel @default(SYSTEM)
  read      Boolean      @default(false)
  userId    String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
}

model NotificationMute {
  id         String  @id @default(uuid())
  muteAll    Boolean @default(false)
  muteForum  Boolean @default(false)
  mutePostId String?
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
}

model Rank {
  id        String  @id
  label     String
  minPoints Int
  badge     String?
  users     User[]
}

model EngagementLog {
  id        String   @id @default(uuid())
  action    String
  points    Int
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AIUsageLog {
  id     String @id @default(uuid())
  type   String
  userId String
  date   String
  count  Int    @default(1)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, type, date])
}

model AdBanner {
  id           String      @id @default(uuid())
  imageUrl     String
  linkUrl      String?
  active       Boolean     @default(true)
  universityId String?
  semesterId   String?
  createdAt    DateTime    @default(now())
  semester     Semester?   @relation(fields: [semesterId], references: [id])
  university   University? @relation(fields: [universityId], references: [id])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  name      String
  fileUrl   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  time        String?  @db.VarChar(50)
  completed   Boolean  @default(false)
  date        DateTime @default(now())
  lectureId   String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model SourceBook {
  id               String            @id @default(uuid())
  title            String
  author           String?
  fileUrl          String?
  fullText         String?
  analysisJson     Json?
  facultyId        String
  semesterId       String?
  telegramMessageId String?
  telegramChatId    String?
  createdAt         DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  libraryResources LibraryResource[]
  faculty          Faculty           @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model LibraryResource {
  id           String          @id @default(uuid())
  type         String
  title        String
  url          String?
  payload      Json?
  category     FacultyCategory
  sourceBookId String?
  originUniId  String?
  sharedBy     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sourceBook   SourceBook?     @relation(fields: [sourceBookId], references: [id])

  @@index([category])
  @@index([sourceBookId])
}

model AllowedChannel {
  id          String          @id @default(uuid())
  youtubeId   String          @unique
  name        String
  handle      String?
  thumbnail   String?
  description String?
  subscribers String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  follows     ChannelFollow[]
}

model ChannelFollow {
  id        String         @id @default(uuid())
  userId    String
  channelId String
  createdAt DateTime       @default(now())
  channel   AllowedChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum ForumType {
  GLOBAL
  SEMESTER
  PRIVATE
}

enum ForumStatus {
  OPEN
  CLOSED
  READ_ONLY
}

enum PostAudience {
  UNIVERSITY
  FOLLOWERS
}

enum NotifChannel {
  SYSTEM
  FORUM
  BROADCAST
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStemLayout {
  STANDARD
  IMAGE_OVERLAY
}

enum PastPaperKind {
  MODULE_QUESTION_BANK
  ADMIN_AUTHORED_QUIZ
  OSCE
}

enum FacultyCategory {
  HUMAN_MEDICINE
  DENTAL_MEDICINE
  PHARMACY
  PHYSICAL_THERAPY
  OTHER
}

model YoutubeUploadTask {
  id               String    @id @default(uuid())
  title            String? // Human-readable label for the job
  sourceUrl        String
  targetPlaylistId String?
  lectureVideoId   String? // Optional: replace this LectureVideo.url after upload
  status           String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress         Int       @default(0) // 0–100
  totalVideos      Int       @default(0)
  syncedVideos     Int       @default(0)
  error            String?
  entityId         String? // References LectureVideo.id (legacy)
  newVideoUrl      String? // The URL of the video after upload
  logs             String? // JSON array of log lines from Colab
  colabLastPoll    DateTime? // Last time Colab checked in (to detect if worker is alive)
  telegramMessageId String?
  telegramChatId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TelegramMigrationTask {
  id              String   @id @default(uuid())
  title           String?
  sourceUrl       String   // The YouTube URL
  lectureVideoId  String?  // Reference to the video in the site
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  telegramMessageId Int?
  telegramChatId  String?
  error           String?
  progress        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

enum TeamRole {
  LEADER
  ADMIN
  MEMBER
}

model MedicalTeam {
  id             String         @id @default(uuid())
  name           String
  description    String?        @db.Text
  imageUrl       String?
  coverUrl       String?
  facultyId      String
  universityId   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  followersCount Int            @default(0)
  inviteCode     String?        @unique
  isPublic       Boolean        @default(true)
  memberLimit    Int?

  telegramGroupId  String?
  telegramTemplate String?       @db.Text
  summaryFrequency String        @default("NONE") // NONE, DAILY, WEEKLY, MONTHLY
  lastSummaryAt    DateTime?

  faculty        Faculty        @relation(fields: [facultyId], references: [id])
  university     University     @relation(fields: [universityId], references: [id])
  members        TeamMember[]
  followers      TeamFollower[]
  lectures       Lecture[]
  posts          Post[]
  teamTasks      TeamTask[]

  @@index([facultyId])
  @@index([universityId])
}

model TeamMember {
  id        String      @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole    @default(MEMBER)
  createdAt DateTime    @default(now())
  team      MedicalTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamFollower {
  id        String      @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime    @default(now())
  team      MedicalTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model PlatformMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  description String?  @db.Text
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotUser {
  id                    String   @id @default(cuid())
  telegramId            String   @unique
  phoneNumber           String?  @unique
  preferredProvider     String?  @default("gemini")
  personalKey           String?  @db.Text
  waitingForKeyProvider String?  
  tempData              Json?    // To store registration steps (name, email, etc.)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Poll {
  id        String       @id @default(uuid())
  question  String
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  options   PollOption[]
  post      Post?
  studyRoomPost StudyRoomPost?
}

model PollOption {
  id        String     @id @default(uuid())
  text      String
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]
}

model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  userId       String
  createdAt    DateTime   @default(now())
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, userId])
}

model TeamTask {
  id          String      @id @default(uuid())
  title       String
  description String?     @db.Text
  deadline    DateTime
  teamId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  team        MedicalTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, deadline])
}

// ── Student-Owned Study Rooms (separate from admin MedicalTeam) ──────────────

model StudyRoom {
  id           String            @id @default(uuid())
  name         String
  description  String?           @db.Text
  inviteCode   String            @unique
  isPublic     Boolean           @default(true)
  memberLimit  Int               @default(10)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  ownerId      String            @unique
  universityId String
  image        String?           @db.Text
  spotifyUrl   String?           @db.Text
  customAiConfig Json?           // { apiKey, provider, model, studentAnalysisPrompt }
  isChatOpen   Boolean           @default(true)
  lastChatCleanup DateTime?
  schedule     StudyRoomSchedule?

  owner        User              @relation("RoomOwner", fields: [ownerId], references: [id])
  university   University        @relation(fields: [universityId], references: [id])
  members      StudyRoomMember[]
  posts        StudyRoomPost[]
  tasks        StudyRoomTask[]

  @@index([universityId])
  @@index([inviteCode])
}

model StudyRoomMember {
  id       String    @id @default(uuid())
  roomId   String
  userId   String
  role     String    @default("MEMBER") // OWNER, MODERATOR, MEMBER
  permissions Json?     // { canKick, canPostNotice, canManageTasks }
  joinedAt DateTime  @default(now())
  room     StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model StudyRoomPost {
  id        String    @id @default(uuid())
  content   String    @db.Text
  roomId    String
  authorId  String
  createdAt DateTime  @default(now())
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  
  imageUrl           String?   @db.Text
  attachments        Json?     // Array of { url: string, type: string, name: string }
  sharedQuestionId   String?
  sharedQuestionData Json?
  sharedQuestion     Question? @relation(fields: [sharedQuestionId], references: [id])
  
  likes    StudyRoomPostLike[]
  comments StudyRoomComment[]

  pollId   String?      @unique
  poll     Poll?        @relation(fields: [pollId], references: [id])

  @@index([roomId, createdAt])
  @@index([authorId])
}

model StudyRoomTask {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  deadline    DateTime?
  completed   Boolean   @default(false)
  completions StudyRoomTaskCompletion[]
  roomId      String
  createdAt   DateTime  @default(now())
  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, deadline])
}

model StudyRoomTaskCompletion {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  completedAt DateTime @default(now())
  
  task      StudyRoomTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Hashtag {
  id        String   @id @default(uuid())
  name      String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  posts     PostHashtag[]
}

model PostHashtag {
  id        String   @id @default(uuid())
  postId    String
  hashtagId String
  
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
}

model StudyRoomComment {
  id           String        @id @default(uuid())
  content      String        @db.Text
  attachments  Json?         // Support voice records, images, etc.
  authorId     String
  postId       String
  parentId     String?
  createdAt    DateTime      @default(now())
  
  author       User              @relation(fields: [authorId], references: [id])
  post         StudyRoomPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent       StudyRoomComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      StudyRoomComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([authorId])
}

model StudyRoomSchedule {
  id        String    @id @default(uuid())
  roomId    String    @unique
  events    Json      // Array of { id, title, start, end, type, location }
  updatedAt DateTime  @updatedAt
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model StudyRoomPostLike {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  post      StudyRoomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}
