generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteConfig {
  id                   String   @id @default(uuid())
  siteName             String   @default("MedOneX")
  logoUrl              String?
  faviconUrl           String?
  primaryColor         String   @default("#0d9488")
  enableAI             Boolean  @default(true)
  enableForum          Boolean  @default(true)
  enableAds            Boolean  @default(true)
  enableNotifs         Boolean  @default(true)
  enableLeaderboard    Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  fontArabic           String?
  fontSans             String?
  aiPreferredProvider  String   @default("auto")
  /// Square icon for PWA “Add to Home Screen” / maskable (512×512). Falls back to faviconUrl then defaults.
  pwaIconUrl           String?
  logoUrlDark          String?
  facebookUrl          String?
  hulkLogoUrl          String?
  instagramUrl         String?
  telegramUrl          String?
  twitterUrl           String?
  whatsappUrl          String?
  youtubeUrl           String?
  enableCreativeStudio Boolean  @default(false)
  stabilityAIKey       String?
  assemblyAIKey        String?
  uploadcarePublicKey  String?
}

model FeatureFlag {
  id           String      @id @default(uuid())
  key          String
  enabled      Boolean     @default(false)
  payload      Json?
  universityId String?
  updatedAt    DateTime    @updatedAt
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, key])
  @@index([key])
}

model University {
  id             String                   @id @default(uuid())
  name           String
  abbr           String?
  logoUrl        String?
  idMinLength    Int                      @default(6)
  idMaxLength    Int                      @default(10)
  createdAt      DateTime                 @default(now())
  academicYears  AcademicYear[]
  adBanners      AdBanner[]
  comments       Comment[]
  faculties      Faculty[]
  featureFlags   FeatureFlag[]
  forums         Forum[]
  guestQuizUsers GuestQuizUser[]
  medicalTeams   MedicalTeam[]
  posts          Post[]
  studyRooms     StudyRoom[]
  yearIdFormats  UniversityYearIdFormat[]
  users          User[]
}

/// Faculty (كليه) — optional sub-division of a University.
/// When present, AcademicYears are grouped under a Faculty.
/// If a University has no Faculties, the old flat structure is preserved (facultyId = null).
model Faculty {
  id             String          @id @default(uuid())
  name           String
  logoUrl        String?
  universityId   String
  createdAt      DateTime        @default(now())
  category       FacultyCategory @default(OTHER)
  academicYears  AcademicYear[]
  university     University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  guestQuizUsers GuestQuizUser[]
  medicalTeams   MedicalTeam[]
  sourceBooks    SourceBook[]
  users          User[]

  @@index([universityId])
  @@index([category])
}

model UniversityYearIdFormat {
  id           String     @id @default(uuid())
  universityId String
  yearNumber   Int
  minLength    Int        @default(6)
  maxLength    Int        @default(10)
  prefix       String?
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, yearNumber])
}

model AcademicYear {
  id           String     @id @default(uuid())
  yearNumber   Int
  universityId String
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id])
  university   University @relation(fields: [universityId], references: [id])
  semesters    Semester[]

  @@unique([universityId, yearNumber, facultyId])
  @@index([facultyId])
}

model Semester {
  id             String             @id @default(uuid())
  name           String
  academicYearId String
  adBanners      AdBanner[]
  forums         Forum[]
  guestQuizUsers GuestQuizUser[]
  modules        Module[]
  pastPapers     PastPaper[]
  playlistSyncs  PlaylistSyncTask[]
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id])
  subjects       Subject[]
  users          User[]
}

model PlaylistSyncTask {
  id          String   @id @default(uuid())
  playlistUrl String
  semesterId  String
  mediaType   String
  editionYear String?
  lastSynced  DateTime @default(now())
  createdAt   DateTime @default(now())
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

model Module {
  id         String      @id @default(uuid())
  name       String
  icon       String?
  semesterId String
  semester   Semester    @relation(fields: [semesterId], references: [id])
  pastPapers PastPaper[]
  subjects   Subject[]
}

model Subject {
  id               String    @id @default(uuid())
  name             String
  icon             String?
  moduleId         String?
  isQuizSystemBank Boolean   @default(false)
  semesterId       String?
  lectures         Lecture[]
  module           Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  semester         Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([moduleId, isQuizSystemBank])
  @@index([semesterId])
}

model Lecture {
  id            String                @id @default(uuid())
  title         String
  videoUrl      String?
  order         Int                   @default(0)
  subjectId     String
  notesMarkdown String?
  extras        Json?
  uiConfig      Json?
  teamId        String?
  type          LectureType           @default(LECTURE)
  checklist     Checklist?
  flashcards    Flashcard[]
  subject       Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  team          MedicalTeam?          @relation(fields: [teamId], references: [id])
  files         LectureFile[]
  records       LectureRecord[]
  videos        LectureVideo[]
  notes         Note[]
  PastPaper     PastPaper?
  questions     Question[]
  activities    UserLectureActivity[]
}

model Checklist {
  id        String          @id @default(uuid())
  title     String
  lectureId String          @unique
  lecture   Lecture         @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(uuid())
  content     String
  points      Int       @default(1)
  isCritical  Boolean   @default(false)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id        String  @id @default(uuid())
  front     String
  back      String
  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model LectureFile {
  id                String  @id @default(uuid())
  name              String
  url               String
  mimeType          String
  lectureId         String
  telegramMessageId Int?
  telegramChatId    String?
  telegramFileId    String?
  shouldBroadcast   Boolean @default(true)
  isBroadcasted     Boolean @default(false)
  lecture           Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model LectureVideo {
  id                String                @id @default(uuid())
  title             String
  url               String
  sourceType        String                @default("external")
  sharingEnabled    Boolean               @default(true)
  likesCount        Int                   @default(0)
  commentsCount     Int                   @default(0)
  sharesCount       Int                   @default(0)
  sortOrder         Int                   @default(0)
  lectureId         String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  telegramMessageId Int?
  telegramChatId    String?
  telegramFileId    String?
  shouldBroadcast   Boolean               @default(true)
  isBroadcasted     Boolean               @default(false)
  startTime         Int?
  endTime           Int?
  isReel            Boolean               @default(false)
  lecture           Lecture               @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  comments          LectureVideoComment[]
  likes             LectureVideoLike[]

  @@index([lectureId, sortOrder])
}

model LectureRecord {
  id                String   @id @default(uuid())
  title             String
  url               String
  sourceType        String   @default("spotify")
  lectureId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  telegramMessageId Int?
  telegramChatId    String?
  lecture           Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model LectureVideoComment {
  id        String                @id @default(uuid())
  content   String
  videoId   String
  userId    String
  createdAt DateTime              @default(now())
  parentId  String?
  parent    LectureVideoComment?  @relation("VideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LectureVideoComment[] @relation("VideoCommentReplies")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     LectureVideo          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId])
}

model LectureVideoLike {
  id      String       @id @default(uuid())
  videoId String
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   LectureVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
}

model Question {
  id                String             @id @default(uuid())
  body              String
  choices           Json
  answer            String
  explanation       String?
  aiExplanation     String?
  difficulty        Difficulty         @default(MEDIUM)
  lectureId         String
  createdAt         DateTime           @default(now())
  imageUrl          String?
  stemLayout        QuestionStemLayout @default(STANDARD)
  essayReference    String?
  questionType      String             @default("MCQ")
  telegramMessageId String?
  telegramChatId    String?
  videoUrl          String?
  videoSource       MediaSource        @default(YOUTUBE)
  stationTime       Int?
  sharedInPosts     Post[]
  lecture           Lecture            @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  reports           QuestionReport[]
  attemptItems      QuizAttemptItem[]
  savedBy           SavedQuestion[]
  studyRoomPosts    StudyRoomPost[]
}

model PastPaper {
  id                      String           @id @default(uuid())
  title                   String
  pdfUrl                  String?
  isInteractive           Boolean          @default(false)
  timeLimitMin            Int?
  semesterId              String
  moduleId                String
  createdAt               DateTime         @default(now())
  aiExplanationEnabled    Boolean          @default(true)
  allowAiDuringQuiz       Boolean          @default(false)
  restrictCopyPaste       Boolean          @default(false)
  secureExamMode          Boolean          @default(false)
  trackFocusLoss          Boolean          @default(false)
  kind                    PastPaperKind    @default(MODULE_QUESTION_BANK)
  quizLectureId           String?          @unique
  googleSheetsSyncEnabled Boolean          @default(false)
  isPrivate               Boolean          @default(false)
  randomizeQuestions      Boolean          @default(false)
  module                  Module           @relation(fields: [moduleId], references: [id])
  quizLecture             Lecture?         @relation(fields: [quizLectureId], references: [id])
  semester                Semester         @relation(fields: [semesterId], references: [id])
  questionReports         QuestionReport[]
  attempts                QuizAttempt[]
}

model QuestionReport {
  id          String     @id @default(uuid())
  questionId  String
  userId      String
  note        String?
  pastPaperId String?
  createdAt   DateTime   @default(now())
  pastPaper   PastPaper? @relation(fields: [pastPaperId], references: [id])
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId, createdAt])
}

model SavedQuestion {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

model GuestQuizUser {
  id                String        @id @default(uuid())
  displayName       String
  externalStudentId String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  facultyId         String?
  semesterId        String?
  universityId      String?
  faculty           Faculty?      @relation(fields: [facultyId], references: [id])
  semester          Semester?     @relation(fields: [semesterId], references: [id])
  university        University?   @relation(fields: [universityId], references: [id])
  quizAttempts      QuizAttempt[]

  @@index([createdAt])
}

model QuizAttempt {
  id              String            @id @default(uuid())
  score           Int
  timeTaken       Int               @default(0)
  userId          String?
  pastPaperId     String
  createdAt       DateTime          @default(now())
  focusLossCount  Int               @default(0)
  guestQuizUserId String?
  guestQuizUser   GuestQuizUser?    @relation(fields: [guestQuizUserId], references: [id], onDelete: Cascade)
  pastPaper       PastPaper         @relation(fields: [pastPaperId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           QuizAttemptItem[]

  @@index([userId])
  @@index([guestQuizUserId])
  @@index([pastPaperId])
}

model StudyAssistantProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  scheduleText      String?
  hobbies           String?
  dailyStudyMinutes Int      @default(120)
  worshipMinutes    Int      @default(30)
  otherRoutines     String?
  currentPlanJson   Json?
  progressJson      Json?
  weekStartIso      String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizAttemptItem {
  id         String      @id @default(uuid())
  chosen     String?
  isCorrect  Boolean
  attemptId  String
  questionId String
  /// AI rubric for ESSAY: scorePercent, stagesMet/Total, feedback, stageNotes
  essayGrade Json?
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model User {
  id                    String                    @id @default(uuid())
  name                  String
  nickname              String?
  email                 String                    @unique
  emailVerified         DateTime?
  image                 String?
  bio                   String?
  phone                 String?
  phoneVisible          Boolean                   @default(false)
  hideRank              Boolean                   @default(false)
  theme                 Theme                     @default(SYSTEM)
  role                  Role                      @default(STUDENT)
  points                Int                       @default(0)
  password              String?
  studentId             String?
  universityId          String?
  semesterId            String?
  rankId                String?
  studentCode           String?                   @unique
  rolePermissions       Json?
  telegramPhone         String?                   @unique
  isLeader              Boolean                   @default(false)
  leaderId              String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  facebookUrl           String?
  instagramUrl          String?
  isPrivate             Boolean                   @default(false)
  canManageReports      Boolean                   @default(false)
  facultyId             String?
  personalGeminiKey     String?
  handle                String?                   @unique
  telegramId            String?                   @unique
  telegramVerified      Boolean                   @default(false)
  coverImage            String?
  aiUsageLogs           AIUsageLog[]
  accounts              Account[]
  auditLogs             AuditLog[]
  channelFollows        ChannelFollow[]
  comments              Comment[]
  commentLikes          CommentLike[]
  dmReceived            DirectMessage[]           @relation("DmReceived")
  dmSent                DirectMessage[]           @relation("DmSent")
  documentTemplates     DocumentTemplate[]
  engagementLogs        EngagementLog[]
  videoComments         LectureVideoComment[]
  videoLikes            LectureVideoLike[]
  likes                 Like[]
  notes                 Note[]
  notifications         Notification[]
  notifMutes            NotificationMute?
  pollVotes             PollVote[]
  posts                 Post[]
  receivedInvites       PrivateForumInvite[]      @relation("InviteReceiver")
  sentInvites           PrivateForumInvite[]      @relation("InviteSender")
  forumMemberships      PrivateForumMember[]
  pushSubscriptions     PushSubscription[]
  questionReports       QuestionReport[]
  quizAttempts          QuizAttempt[]
  savedPosts            SavedPost[]
  savedQuestions        SavedQuestion[]
  sessions              Session[]
  studyAssistantProfile StudyAssistantProfile?
  ownedStudyRoom        StudyRoom?                @relation("RoomOwner")
  studyRoomComments     StudyRoomComment[]
  studyRoomMembers      StudyRoomMember[]
  studyRoomPosts        StudyRoomPost[]
  studyRoomPostLikes    StudyRoomPostLike[]
  taskCompletions       StudyRoomTaskCompletion[]
  followedTeams         TeamFollower[]
  teamMemberships       TeamMember[]
  faculty               Faculty?                  @relation(fields: [facultyId], references: [id])
  rank                  Rank?                     @relation(fields: [rankId], references: [id])
  semester              Semester?                 @relation(fields: [semesterId], references: [id])
  university            University?               @relation(fields: [universityId], references: [id])
  v2IdentityProviders   IdentityProvider[]
  v2RoleAssignments     UserRoleAssignment[]
  v2TeacherProfile      TeacherProfile?
  v2CourseEnrollments   CourseEnrollment[]
  v2AuditLogs           V2AuditLog[]
  v2OutboxEvents        OutboxEvent[]             @relation("OutboxActor")
  following             UserFollow[]              @relation("UserFollows")
  followers             UserFollow[]              @relation("UserFollowers")
  lectureActivities     UserLectureActivity[]
  tasks                 UserTask[]
  atlasBookmarks        AtlasBookmark[]
  atlasNotes            AtlasNote[]
}

model TelegramConfig {
  id               String   @id @default("global")
  welcomeMessage   String?
  broadcastMessage String?
  botStatus        String   @default("ACTIVE")
  defaultProvider  String   @default("gemini")
  defaultModel     String?
  updatedAt        DateTime @updatedAt
}

model BotAuth {
  id         String   @id @default(uuid())
  code       String   @unique
  telegramId String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  content   String
  lectureId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
}

model UserLectureActivity {
  id           String   @id @default(uuid())
  userId       String
  lectureId    String
  source       String?
  lastViewedAt DateTime @default(now())
  isCompleted  Boolean  @default(false)
  lecture      Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId, lastViewedAt])
  @@index([lectureId])
}

model DirectMessage {
  id         String   @id @default(uuid())
  body       String
  read       Boolean  @default(false)
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  receiver   User     @relation("DmReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("DmSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId, read])
  @@index([senderId, receiverId, createdAt])
}

model Forum {
  id           String               @id @default(uuid())
  name         String
  type         ForumType
  status       ForumStatus          @default(OPEN)
  semesterId   String?
  createdBy    String?
  createdAt    DateTime             @default(now())
  universityId String
  semester     Semester?            @relation(fields: [semesterId], references: [id])
  university   University           @relation(fields: [universityId], references: [id])
  posts        Post[]
  invites      PrivateForumInvite[]
  members      PrivateForumMember[]

  @@index([universityId, type, status])
}

model PrivateForumMember {
  id      String @id @default(uuid())
  forumId String
  userId  String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([forumId, userId])
}

model PrivateForumInvite {
  id         String   @id @default(uuid())
  forumId    String
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  forum      Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  receiver   User     @relation("InviteReceiver", fields: [receiverId], references: [id])
  sender     User     @relation("InviteSender", fields: [senderId], references: [id])

  @@unique([forumId, receiverId])
}

model Post {
  id                   String        @id @default(uuid())
  content              String
  imageUrl             String?
  telegramFileId       String?
  telegramChatId       String?
  telegramMessageId    String?
  attachments          Json?
  interactionsDisabled Boolean       @default(false)
  authorId             String
  forumId              String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  audience             PostAudience  @default(UNIVERSITY)
  universityId         String
  expiresAt            DateTime?
  isPinned             Boolean       @default(false)
  isChatMessage        Boolean       @default(false)
  isForumPost          Boolean       @default(true)
  teamId               String?
  pollId               String?       @unique
  sharedQuestionId     String?
  sharedQuestionData   Json?
  isReel               Boolean       @default(false)
  videoStartTime       Int?
  videoEndTime         Int?
  comments             Comment[]
  likes                Like[]
  author               User          @relation(fields: [authorId], references: [id])
  forum                Forum         @relation(fields: [forumId], references: [id])
  poll                 Poll?         @relation(fields: [pollId], references: [id])
  sharedQuestion       Question?     @relation(fields: [sharedQuestionId], references: [id])
  team                 MedicalTeam?  @relation(fields: [teamId], references: [id])
  university           University    @relation(fields: [universityId], references: [id])
  hashtags             PostHashtag[]
  savedBy              SavedPost[]

  @@index([universityId, createdAt])
  @@index([forumId, createdAt])
  @@index([audience, createdAt])
}

model Comment {
  id           String        @id @default(uuid())
  content      String
  attachments  Json?
  authorId     String
  postId       String
  parentId     String?
  createdAt    DateTime      @default(now())
  universityId String
  author       User          @relation(fields: [authorId], references: [id])
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  university   University    @relation(fields: [universityId], references: [id])
  likes        CommentLike[]

  @@index([universityId, createdAt])
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model Like {
  id     String @id @default(uuid())
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model CommentLike {
  id        String  @id @default(uuid())
  userId    String
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
}

model Notification {
  id        String       @id @default(uuid())
  title     String
  body      String
  channel   NotifChannel @default(SYSTEM)
  read      Boolean      @default(false)
  userId    String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

model NotificationMute {
  id         String  @id @default(uuid())
  muteAll    Boolean @default(false)
  muteForum  Boolean @default(false)
  mutePostId String?
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
}

model Rank {
  id        String  @id
  label     String
  minPoints Int
  badge     String?
  users     User[]
}

model EngagementLog {
  id        String   @id @default(uuid())
  action    String
  points    Int
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AIUsageLog {
  id     String @id @default(uuid())
  type   String
  userId String
  date   String
  count  Int    @default(1)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, type, date])
}

model AdBanner {
  id           String      @id @default(uuid())
  imageUrl     String
  linkUrl      String?
  active       Boolean     @default(true)
  universityId String?
  semesterId   String?
  createdAt    DateTime    @default(now())
  semester     Semester?   @relation(fields: [semesterId], references: [id])
  university   University? @relation(fields: [universityId], references: [id])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model DocumentTemplate {
  id        String   @id @default(uuid())
  name      String
  fileUrl   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  time        String?  @db.VarChar(50)
  completed   Boolean  @default(false)
  date        DateTime @default(now())
  lectureId   String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model SourceBook {
  id                String            @id @default(uuid())
  title             String
  author            String?
  fileUrl           String?
  fullText          String?
  analysisJson      Json?
  facultyId         String
  semesterId        String?
  telegramMessageId String?
  telegramChatId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  libraryResources  LibraryResource[]
  faculty           Faculty           @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model LibraryResource {
  id           String          @id @default(uuid())
  type         String
  title        String
  url          String?
  payload      Json?
  category     FacultyCategory
  sourceBookId String?
  originUniId  String?
  sharedBy     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sourceBook   SourceBook?     @relation(fields: [sourceBookId], references: [id])

  @@index([category])
  @@index([sourceBookId])
}

model AllowedChannel {
  id          String          @id @default(uuid())
  youtubeId   String          @unique
  name        String
  handle      String?
  thumbnail   String?
  description String?
  subscribers String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  follows     ChannelFollow[]
}

model ChannelFollow {
  id        String         @id @default(uuid())
  userId    String
  channelId String
  createdAt DateTime       @default(now())
  channel   AllowedChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model YoutubeUploadTask {
  id                String    @id @default(uuid())
  title             String?
  sourceUrl         String
  targetPlaylistId  String?
  lectureVideoId    String?
  status            String    @default("PENDING")
  progress          Int       @default(0)
  totalVideos       Int       @default(0)
  syncedVideos      Int       @default(0)
  error             String?
  entityId          String?
  newVideoUrl       String?
  logs              String?
  colabLastPoll     DateTime?
  telegramMessageId String?
  telegramChatId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TelegramMigrationTask {
  id                String   @id @default(uuid())
  title             String?
  sourceUrl         String
  lectureVideoId    String?
  status            String   @default("PENDING")
  telegramMessageId Int?
  telegramChatId    String?
  error             String?
  progress          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

model MedicalTeam {
  id               String         @id @default(uuid())
  name             String
  description      String?
  imageUrl         String?
  coverUrl         String?
  facultyId        String
  universityId     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  followersCount   Int            @default(0)
  inviteCode       String?        @unique
  isPublic         Boolean        @default(true)
  memberLimit      Int?
  telegramGroupId  String?
  telegramTemplate String?
  summaryFrequency String         @default("NONE")
  lastSummaryAt    DateTime?
  auditLogs        AuditLog[]
  lectures         Lecture[]
  faculty          Faculty        @relation(fields: [facultyId], references: [id])
  university       University     @relation(fields: [universityId], references: [id])
  posts            Post[]
  followers        TeamFollower[]
  members          TeamMember[]
  teamTasks        TeamTask[]

  @@index([facultyId])
  @@index([universityId])
}

model TeamMember {
  id        String      @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole    @default(MEMBER)
  createdAt DateTime    @default(now())
  team      MedicalTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamFollower {
  id        String      @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime    @default(now())
  team      MedicalTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model PlatformMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotUser {
  id                    String   @id @default(cuid())
  telegramId            String   @unique
  phoneNumber           String?  @unique
  preferredProvider     String?  @default("gemini")
  personalKey           String?
  waitingForKeyProvider String?
  tempData              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Poll {
  id            String         @id @default(uuid())
  question      String
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  options       PollOption[]
  post          Post?
  studyRoomPost StudyRoomPost?
}

model PollOption {
  id     String     @id @default(uuid())
  text   String
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  userId       String
  createdAt    DateTime   @default(now())
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, userId])
}

model TeamTask {
  id          String      @id @default(uuid())
  title       String
  description String?
  deadline    DateTime
  teamId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  team        MedicalTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, deadline])
}

model StudyRoom {
  id              String             @id @default(uuid())
  name            String
  description     String?
  inviteCode      String             @unique
  isPublic        Boolean            @default(true)
  memberLimit     Int                @default(10)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  ownerId         String             @unique
  universityId    String
  image           String?
  spotifyUrl      String?
  customAiConfig  Json?
  isChatOpen      Boolean            @default(true)
  lastChatCleanup DateTime?
  owner           User               @relation("RoomOwner", fields: [ownerId], references: [id])
  university      University         @relation(fields: [universityId], references: [id])
  members         StudyRoomMember[]
  posts           StudyRoomPost[]
  schedule        StudyRoomSchedule?
  tasks           StudyRoomTask[]

  @@index([universityId])
  @@index([inviteCode])
}

model StudyRoomMember {
  id          String    @id @default(uuid())
  roomId      String
  userId      String
  role        String    @default("MEMBER")
  permissions Json?
  joinedAt    DateTime  @default(now())
  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model StudyRoomPost {
  id                 String              @id @default(uuid())
  content            String
  roomId             String
  authorId           String
  createdAt          DateTime            @default(now())
  imageUrl           String?
  attachments        Json?
  sharedQuestionId   String?
  sharedQuestionData Json?
  pollId             String?             @unique
  comments           StudyRoomComment[]
  author             User                @relation(fields: [authorId], references: [id])
  poll               Poll?               @relation(fields: [pollId], references: [id])
  room               StudyRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sharedQuestion     Question?           @relation(fields: [sharedQuestionId], references: [id])
  likes              StudyRoomPostLike[]

  @@index([roomId, createdAt])
  @@index([authorId])
}

model StudyRoomTask {
  id          String                    @id @default(uuid())
  title       String
  description String?
  deadline    DateTime?
  completed   Boolean                   @default(false)
  roomId      String
  createdAt   DateTime                  @default(now())
  room        StudyRoom                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  completions StudyRoomTaskCompletion[]

  @@index([roomId, deadline])
}

model StudyRoomTaskCompletion {
  id          String        @id @default(uuid())
  taskId      String
  userId      String
  completedAt DateTime      @default(now())
  task        StudyRoomTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Hashtag {
  id        String        @id @default(uuid())
  name      String        @unique
  count     Int           @default(0)
  updatedAt DateTime      @updatedAt
  posts     PostHashtag[]
}

model PostHashtag {
  id        String  @id @default(uuid())
  postId    String
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
}

model StudyRoomComment {
  id          String             @id @default(uuid())
  content     String
  attachments Json?
  authorId    String
  postId      String
  parentId    String?
  createdAt   DateTime           @default(now())
  author      User               @relation(fields: [authorId], references: [id])
  parent      StudyRoomComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     StudyRoomComment[] @relation("CommentReplies")
  post        StudyRoomPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model StudyRoomSchedule {
  id        String    @id @default(uuid())
  roomId    String    @unique
  events    Json
  updatedAt DateTime  @updatedAt
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model StudyRoomPostLike {
  id     String        @id @default(uuid())
  postId String
  userId String
  post   StudyRoomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model AuditLog {
  id        String       @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  userId    String
  teamId    String?
  createdAt DateTime     @default(now())
  team      MedicalTeam? @relation(fields: [teamId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
}

enum LectureType {
  LECTURE
  PRACTICAL
}

enum MediaSource {
  YOUTUBE
  DRIVE
  TELEGRAM
  EXTERNAL
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum ForumType {
  GLOBAL
  SEMESTER
  PRIVATE
}

enum ForumStatus {
  OPEN
  CLOSED
  READ_ONLY
}

enum PostAudience {
  UNIVERSITY
  FOLLOWERS
}

enum NotifChannel {
  SYSTEM
  FORUM
  BROADCAST
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStemLayout {
  STANDARD
  IMAGE_OVERLAY
}

enum PastPaperKind {
  MODULE_QUESTION_BANK
  ADMIN_AUTHORED_QUIZ
  OSCE
}

enum FacultyCategory {
  HUMAN_MEDICINE
  DENTAL_MEDICINE
  PHARMACY
  PHYSICAL_THERAPY
  OTHER
}

enum TeamRole {
  LEADER
  ADMIN
  MEMBER
}
enum PlatformRole {
  SUPER_ADMIN
  FACULTY_ADMIN
  TEACHER
  STUDENT
}

enum CourseVisibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionTypeV2 {
  MCQ
  MULTI_SELECT
  TRUE_FALSE
  CASE_BASED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuizAttemptState {
  IN_PROGRESS
  SUBMITTED
  AUTO_GRADED
  REVIEWED
}

model Tenant {
  id            String         @id @default(uuid())
  key           String         @unique
  displayName   String
  status        String         @default("ACTIVE")
  defaultDomain String?
  config        TenantConfig?
  domains       TenantDomain[]
  users         UserRoleAssignment[]
  courses       CourseCatalog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TenantDomain {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain    String   @unique
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model TenantConfig {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiPreferredProvider    String   @default("auto")
  aiDailyStudentQuota    Int      @default(25)
  aiAdminGenerationLimit Int      @default(200)
  featureFlagsJson       Json?
  updatedAt              DateTime @updatedAt
}

model V2Role {
  id          String               @id @default(uuid())
  key         String               @unique
  title       String
  assignments UserRoleAssignment[]

  @@map("V2Role")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?
}

model UserRoleAssignment {
  id         String       @id @default(uuid())
  userId     String
  tenantId   String
  roleId     String
  scopeJson  Json?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       V2Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, tenantId, roleId])
  @@index([tenantId, roleId])
}

model IdentityProvider {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  providerUid  String
  accountEmail String?
  createdAt    DateTime @default(now())

  @@unique([provider, providerUid])
  @@index([userId])
}

model TeacherProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  verified        Boolean      @default(false)
  ratingAvg       Float        @default(0)
  ratingCount     Int          @default(0)
  totalStudents   Int          @default(0)
  courses         CourseCatalog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model CourseCatalog {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherProfileId String
  teacherProfile  TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  description     String?
  visibility      CourseVisibility @default(DRAFT)
  tagsJson        Json?
  pricing         CoursePricing?
  enrollments     CourseEnrollment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, visibility])
}

model CoursePricing {
  id            String       @id @default(uuid())
  courseId      String       @unique
  course        CourseCatalog @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currency      String       @default("USD")
  amountCents   Int
  compareAtCents Int?
  updatedAt     DateTime     @updatedAt
}

model CourseEnrollment {
  id          String       @id @default(uuid())
  courseId    String
  course      CourseCatalog @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String       @default("ACTIVE")
  enrolledAt  DateTime     @default(now())
  completedAt DateTime?

  @@unique([courseId, userId])
  @@index([userId, status])
}

model V2AuditLog {
  id          String   @id @default(uuid())
  tenantKey   String?
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantKey, createdAt])
  @@index([actorUserId, createdAt])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  channel   String
  subject   String?
  body      String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model OutboxEvent {
  id            String   @id @default(uuid())
  tenantKey     String?
  topic         String
  payload       Json
  actorUserId   String?
  actor         User?    @relation("OutboxActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  occurredAt    DateTime @default(now())
  publishedAt   DateTime?
  retryCount    Int      @default(0)
  lastError     String?

  @@index([publishedAt, occurredAt])
  @@index([tenantKey, occurredAt])
}

model V2Faculty {
  id          String    @id @default(uuid())
  tenantKey   String
  code        String
  name        String
  programs    Program[]
  communities Community[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantKey, code])
}

model Program {
  id            String        @id @default(uuid())
  tenantKey     String
  facultyId     String
  faculty       V2Faculty     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  curriculums   Curriculum[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantKey, facultyId, code])
}

model Curriculum {
  id              String            @id @default(uuid())
  tenantKey       String
  programId       String
  program         Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  code            String
  title           String
  levels          CurriculumLevel[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([tenantKey, programId, code])
}

model CurriculumLevel {
  id              String       @id @default(uuid())
  tenantKey       String
  curriculumId    String
  curriculum      Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  levelNumber     Int
  name            String
  terms           Term[]

  @@unique([curriculumId, levelNumber])
  @@index([tenantKey, levelNumber])
}

model Term {
  id              String          @id @default(uuid())
  tenantKey       String
  levelId         String
  level           CurriculumLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  name            String
  modules         V2Module[]
  enrollments     StudentEnrollment[]

  @@index([tenantKey, name])
}

model V2Module {
  id              String      @id @default(uuid())
  tenantKey       String
  termId          String
  term            Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  code            String
  name            String
  isOptional      Boolean     @default(false)
  subjects        V2Subject[]
  quizzes         V2Quiz[]

  @@unique([tenantKey, termId, code])
}

model V2Subject {
  id              String      @id @default(uuid())
  tenantKey       String
  moduleId        String
  module          V2Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code            String
  name            String
  lectures        V2Lecture[]
  questionBanks   QuestionBank[]
  studentProgress StudentProgress[]

  @@unique([tenantKey, moduleId, code])
}

model V2Lecture {
  id              String                @id @default(uuid())
  tenantKey       String
  subjectId       String
  subject         V2Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  status          String                @default("DRAFT")
  componentToggle LectureComponentToggle[]
  files           V2LectureFile[]
  notes           V2LectureNote[]
  videos          V2LectureVideo[]
  flashcardSets   V2LectureFlashcardSet[]
  quizzes         V2Quiz[]
  studySessions   V2StudySession[]
  savedByStudents V2SavedLecture[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([tenantKey, subjectId, slug])
}

model LectureComponentToggle {
  id         String    @id @default(uuid())
  lectureId  String
  lecture    V2Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  component  String
  enabled    Boolean   @default(true)
  updatedAt  DateTime  @updatedAt

  @@unique([lectureId, component])
}

model V2LectureFile {
  id         String    @id @default(uuid())
  lectureId  String
  lecture    V2Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  fileUrl    String
  title      String?
  createdAt  DateTime  @default(now())
}

model V2LectureNote {
  id         String    @id @default(uuid())
  lectureId  String
  lecture    V2Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  authorUserId String
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model V2LectureVideo {
  id         String    @id @default(uuid())
  lectureId  String
  lecture    V2Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  videoUrl   String
  title      String
  sortOrder  Int       @default(0)
}

model V2LectureFlashcardSet {
  id         String    @id @default(uuid())
  lectureId  String
  lecture    V2Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  title      String
  source     String    @default("MANUAL")
  cardsJson  Json
  createdAt  DateTime  @default(now())
}

model QuestionBank {
  id         String      @id @default(uuid())
  tenantKey  String
  subjectId  String
  subject    V2Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title      String
  questions  V2Question[]
}

model V2Question {
  id               String          @id @default(uuid())
  tenantKey        String
  questionBankId   String
  questionBank     QuestionBank    @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  stem             String
  type             QuestionTypeV2
  difficulty       DifficultyLevel
  explanation      String?
  options          V2QuestionOption[]
  tags             V2QuestionTag[]
  versions         V2QuestionVersion[]
  quizQuestions    QuizQuestion[]
  createdAt        DateTime        @default(now())
}

model V2QuestionOption {
  id           String     @id @default(uuid())
  questionId   String
  question     V2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key          String
  content      String
  isCorrect    Boolean

  @@unique([questionId, key])
}

model V2QuestionTag {
  id           String     @id @default(uuid())
  questionId   String
  question     V2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag          String

  @@index([tag])
}

model V2QuestionVersion {
  id           String     @id @default(uuid())
  questionId   String
  question     V2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version      Int
  snapshotJson Json
  createdAt    DateTime   @default(now())

  @@unique([questionId, version])
}

model V2Quiz {
  id              String       @id @default(uuid())
  tenantKey       String
  moduleId        String
  module          V2Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lectureId       String?
  lecture         V2Lecture?   @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  title           String
  timeLimitSec    Int?
  aiExplanation   Boolean      @default(false)
  questions       QuizQuestion[]
  attempts        V2QuizAttempt[]
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
}

model QuizQuestion {
  id          String     @id @default(uuid())
  quizId      String
  quiz        V2Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId  String
  question    V2Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  orderNo     Int
  points      Float      @default(1)

  @@unique([quizId, questionId])
  @@unique([quizId, orderNo])
}

model V2QuizAttempt {
  id            String           @id @default(uuid())
  tenantKey     String
  quizId         String
  quiz          V2Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentUserId String
  startedAt     DateTime         @default(now())
  submittedAt   DateTime?
  state         QuizAttemptState @default(IN_PROGRESS)
  scorePercent  Float?
  answers       QuizAttemptAnswer[]
}

model QuizAttemptAnswer {
  id             String        @id @default(uuid())
  attemptId      String
  attempt        V2QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  answerJson     Json
  isCorrect      Boolean?
  earnedPoints   Float?

  @@unique([attemptId, questionId])
}

model QuizAnalyticsSnapshot {
  id               String   @id @default(uuid())
  tenantKey        String
  quizId           String
  generatedAt      DateTime @default(now())
  participantCount Int
  metricsJson      Json

  @@index([tenantKey, quizId, generatedAt])
}

model StudentEnrollment {
  id             String   @id @default(uuid())
  tenantKey      String
  studentUserId  String
  termId         String
  term           Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  @@unique([studentUserId, termId])
}

model StudentProgress {
  id             String   @id @default(uuid())
  tenantKey      String
  studentUserId  String
  subjectId      String
  subject        V2Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  completionPct  Float    @default(0)
  lastActivityAt DateTime?

  @@unique([studentUserId, subjectId])
}

model V2StudySession {
  id            String    @id @default(uuid())
  tenantKey     String
  studentUserId String
  lectureId     String?
  lecture       V2Lecture? @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  durationSec   Int?
}

model V2SavedLecture {
  id            String    @id @default(uuid())
  tenantKey     String
  studentUserId String
  lectureId     String
  lecture       V2Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@unique([studentUserId, lectureId])
}

model Community {
  id           String    @id @default(uuid())
  tenantKey    String
  facultyId    String
  faculty      V2Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  name         String
  posts        V2Post[]
  groups       V2Group[]
}

model V2Post {
  id           String      @id @default(uuid())
  communityId  String
  community    Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorUserId String
  title        String
  body         String
  comments     V2Comment[]
  reactions    V2Reaction[]
  createdAt    DateTime    @default(now())
}

model V2Comment {
  id           String   @id @default(uuid())
  postId       String
  post         V2Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String
  parentId     String?
  createdAt    DateTime @default(now())
}

model V2Reaction {
  id           String   @id @default(uuid())
  postId       String
  post         V2Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       String
  type         String

  @@unique([postId, userId, type])
}

model V2Group {
  id            String            @id @default(uuid())
  communityId   String
  community     Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title         String
  memberships   V2GroupMembership[]
  messages      V2Message[]
}

model V2GroupMembership {
  id            String   @id @default(uuid())
  groupId       String
  group         V2Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  role          String   @default("MEMBER")
  createdAt     DateTime @default(now())

  @@unique([groupId, userId])
}

model V2Message {
  id            String   @id @default(uuid())
  groupId       String
  group         V2Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderUserId  String
  body          String
  createdAt     DateTime @default(now())
}

model Workspace {
  id             String          @id @default(uuid())
  tenantKey      String
  ownerUserId    String
  title          String          @default("My Study Space")
  background     String?
  widgets             WidgetInstance[]
  pomodoroSessions    PomodoroSession[]
  whiteboardDocuments WhiteboardDocument[]
  updatedAt           DateTime        @updatedAt
}

model WidgetInstance {
  id             String        @id @default(uuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type           String
  configJson     Json?
  layout         WidgetLayout?
}

model WidgetLayout {
  id               String         @id @default(uuid())
  widgetInstanceId String         @unique
  widgetInstance   WidgetInstance @relation(fields: [widgetInstanceId], references: [id], onDelete: Cascade)
  x                Int
  y                Int
  w                Int
  h                Int
}

model PomodoroSession {
  id             String   @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId    String
  durationMin    Int
  startedAt      DateTime @default(now())
  endedAt        DateTime?
}

model WhiteboardDocument {
  id             String   @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUserId    String
  title          String
  contentJson    Json
  updatedAt      DateTime @updatedAt
}

// --- Atlas Models ---

model AtlasSystem {
  id         String           @id @default(uuid())
  systemId   String           @unique
  label      String
  color      String
  border     String
  iconColor  String
  iconName   String           @default("Activity")
  desc       String
  structures AtlasStructure[]
}

model AtlasStructure {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  latin       String?
  type        String   @default("organ")
  desc        String
  region      String?
  systemId    String
  fn          String?
  blood       String?
  nerve       String?
  relations   Json?
  clinical    String?
  memo        String?
  imageUrl    String?
  modelUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  system      AtlasSystem      @relation(fields: [systemId], references: [systemId], onDelete: Cascade)
  bookmarks   AtlasBookmark[]
  notes       AtlasNote[]
}

model AtlasBookmark {
  id          String   @id @default(uuid())
  userId      String
  structureId String
  createdAt   DateTime @default(now())
  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  structure   AtlasStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([userId, structureId])
}

model AtlasNote {
  id          String   @id @default(uuid())
  userId      String
  structureId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  structure   AtlasStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([userId, structureId])
}
