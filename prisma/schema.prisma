  userId       String
  issuedById   String
  severity     WarningSeverity @default(MODERATE)
  status       WarningStatus   @default(ACTIVE)
  reason       String
  description  String?
  notes        String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User  @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy   User  @relation("IssuedWarnings", fields: [issuedById], references: [id], onDelete: Cascade)
  revokedBy  User? @relation("RevokedWarnings", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([issuedById])
  @@index([createdAt])
  @@index([severity])
}

model AdminActionLog {
  id            String   @id @default(uuid())
  adminId       String
  action        String
  entityType    String
  entityId      String?
  previousState Json?
  newState      Json?
  description   String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model SecurityEvent {
  id             String               @id @default(uuid())
  type           SecurityEventType
  severity       SecurityEventSeverity
  status         SecurityEventStatus  @default(NEW)
  userId         String?
  ipAddress      String?
  userAgent      String?
  endpoint       String?
  requestMethod  String?
  requestPayload Json?
  headers        Json?
  location       Json?
  description    String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolution     String?
  createdAt      DateTime             @default(now())

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("SecurityResolution", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([status, severity, createdAt])
}

model UserSessionLog {
  id              String    @id @default(uuid())
  userId          String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  lastHeartbeatAt DateTime?
  durationSeconds Int?
  ipAddress       String?
  userAgent       String?
  deviceType      String?
  platform        String?
  country         String?
  city            String?
  isActive        Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([isActive])
  @@index([startedAt])
  @@index([deviceType])
}

model PageView {
  id         String   @id @default(uuid())
  userId     String?
  path       String
  title      String?
  referrer   String?
  durationMs Int?
  deviceType String?
  platform   String?
  ipAddress  String?
  sessionId  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
  @@index([sessionId])
}

model SourceBook {
  id           String   @id @default(uuid())
  title        String
  author       String?
  fileUrl      String?
  fullText     String?
  analysisJson Json?
  facultyId    String
  semesterId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faculty  Faculty           @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  resources LibraryResource[]

  @@index([facultyId])
  @@index([semesterId])
}

model LibraryResource {
  id           String   @id @default(uuid())
  title        String
  type         String
  url          String?
  payload      Json?
  category     String
  sourceBookId String?
  originUniId  String?
  originUniversity University? @relation(fields: [originUniId], references: [id])
  sharedBy     String?
  sharedByUser User?     @relation(fields: [sharedBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sourceBook SourceBook? @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([sourceBookId])
}

model TelegramMigrationTask {
  id                String   @id @default(uuid())
  title             String?
  sourceUrl         String
  lectureVideoId    String?
  status            String   @default("PENDING")
  telegramMessageId Int?
  telegramChatId    String?
  error             String?
  progress          Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lectureVideo LectureVideo? @relation(fields: [lectureVideoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([lectureVideoId])
}

model AllowedChannel {
  id          String   @id @default(uuid())
  youtubeId   String   @unique
  name        String
  handle      String?
  thumbnail   String?
  description String?
  subscribers String?
  createdAt   DateTime @default(now())

  follows ChannelFollow[]

  @@index([youtubeId])
}

model ChannelFollow {
  id        String   @id @default(uuid())
  userId    String
  channelId String
  createdAt DateTime @default(now())

  channel AllowedChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

model VideoViewTracking {
  id                  String   @id @default(uuid())
  videoId             String
  userId              String?
  lectureId           String?
  watchDurationSeconds Int?
  watchPercentage     Float?
  completed           Boolean  @default(false)
  ipAddress           String?
  createdAt           DateTime @default(now())

  lectureVideo LectureVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([videoId, createdAt])
  @@index([userId])
  @@index([lectureId])
}

model AdminAIKeys {
  id                      String   @id @default(uuid())
  adminId                 String   @unique
  admin                   User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  encryptedGeminiKey      String?
  encryptedOpenAIKey      String?
  encryptedAnthropicKey   String?
  encryptedDeepseekKey    String?
  encryptedGroqKey        String?
  encryptedOpenrouterKey  String?
  encryptedXaiKey         String?
  encryptedMistralKey     String?
  encryptedTogetherKey    String?
  encryptedHuggingfaceKey String?
  encryptedCloudflareKey  String?
  encryptedCerebrasKey    String?
  encryptedGithubKey      String?
  encryptedProxyKey       String?
  defaultAutoProvider     String? @default("auto")
  featureOverrides        Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
