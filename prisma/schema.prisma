generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteConfig {
  id                      String   @id @default(uuid())
  siteName                String   @default("MedOneX")
  logoUrl                 String?
  faviconUrl              String?
  primaryColor            String   @default("#0d9488")
  enableAI                Boolean  @default(true)
  enableForum             Boolean  @default(true)
  enableAds               Boolean  @default(true)
  enableNotifs            Boolean  @default(true)
  enableLeaderboard       Boolean  @default(true)
  updatedAt               DateTime @updatedAt
  fontArabic              String?
  fontSans                String?
  aiPreferredProvider     String   @default("auto")
  /// Square icon for PWA GÇ£Add to Home ScreenGÇ¥ / maskable (512+ù512). Falls back to faviconUrl then defaults.
  pwaIconUrl              String?
  logoUrlDark             String?
  facebookUrl             String?
  hulkLogoUrl             String?
  instagramUrl            String?
  telegramUrl             String?
  twitterUrl              String?
  whatsappUrl             String?
  youtubeUrl              String?
  linkedinUrl             String?
  tiktokUrl               String?
  enableCreativeStudio    Boolean  @default(false)
  stabilityAIKey          String?
  assemblyAIKey           String?
  uploadcarePublicKey     String?
  siliconFlowKey          String?
  siliconFlowUrl          String?  @default("https://api.siliconflow.cn/v1")
  siliconFlowModel        String?  @default("deepseek-ai/DeepSeek-R1")
  geminiKeyOverride       String?
  deepseekKeyOverride     String?
  deepseekUrlOverride     String?
  groqKeyOverride         String?
  groqModelOverride       String?
  openRouterKeyOverride   String?
  openRouterModelOverride String?
  xaiKeyOverride          String?
  xaiModelOverride        String?
  proxyUrlOverride        String?
  proxyKeyOverride        String?
  anthropicKeyOverride    String?
  anthropicModelOverride  String?
  openAIKeyOverride       String?
  openAIModelOverride     String?
}

model FeatureFlag {
  id           String      @id @default(uuid())
  key          String
  enabled      Boolean     @default(false)
  payload      Json?
  universityId String?
  updatedAt    DateTime    @updatedAt
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, key])
  @@index([key])
}

model University {
  id             String                   @id @default(uuid())
  name           String
  abbr           String?
  logoUrl        String?
  idMinLength    Int                      @default(6)
  idMaxLength    Int                      @default(10)
  createdAt      DateTime                 @default(now())
  academicYears  AcademicYear[]
  adBanners      AdBanner[]
  comments       Comment[]
  faculties      Faculty[]
  featureFlags   FeatureFlag[]
  forums         Forum[]
  guestQuizUsers GuestQuizUser[]
  medicalTeams   MedicalTeam[]
  posts          Post[]
  studyRooms     StudyRoom[]
  yearIdFormats  UniversityYearIdFormat[]
  users          User[]
  originatedResources LibraryResource[]
}

/// Faculty (+â+ä+è+ç) GÇö optional sub-division of a University.
/// When present, AcademicYears are grouped under a Faculty.
/// If a University has no Faculties, the old flat structure is preserved (facultyId = null).
model Faculty {
  id             String          @id @default(uuid())
  name           String
  logoUrl        String?
  universityId   String
  createdAt      DateTime        @default(now())
  category       FacultyCategory @default(OTHER)
  academicYears  AcademicYear[]
  university     University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  guestQuizUsers GuestQuizUser[]
  medicalTeams   MedicalTeam[]
  users          User[]
  sourceBooks    SourceBook[]

  @@index([universityId])
  @@index([category])
}

model UniversityYearIdFormat {
  id           String     @id @default(uuid())
  universityId String
  yearNumber   Int
  minLength    Int        @default(6)
  maxLength    Int        @default(10)
  prefix       String?
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, yearNumber])
}

model AcademicYear {
  id           String     @id @default(uuid())
  yearNumber   Int
  universityId String
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  semesters    Semester[]

  @@unique([universityId, yearNumber, facultyId])
  @@index([facultyId])
}

model Semester {
  id             String             @id @default(uuid())
  name           String
  academicYearId String
  adBanners      AdBanner[]
  forums         Forum[]
  guestQuizUsers GuestQuizUser[]
  modules        Module[]
  pastPapers     PastPaper[]
  playlistSyncs  PlaylistSyncTask[]
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  users          User[]
}

model PlaylistSyncTask {
  id          String   @id @default(uuid())
  playlistUrl String
  semesterId  String
  mediaType   String
  editionYear String?
  lastSynced  DateTime @default(now())
  createdAt   DateTime @default(now())
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

model Module {
  id         String      @id @default(uuid())
  name       String
  icon       String?
  imageUrl   String?
  semesterId String
  semester   Semester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  pastPapers PastPaper[]
  subjects   Subject[]
}

model Subject {
  id               String    @id @default(uuid())
  name             String
  icon             String?
  moduleId         String?
  isQuizSystemBank Boolean   @default(false)
  semesterId       String?
  lectures         Lecture[]
  module           Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  semester         Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([moduleId, isQuizSystemBank])
  @@index([semesterId])
}

model Lecture {
  id            String                @id @default(uuid())
  title         String
  videoUrl      String?
  order         Int                   @default(0)
  subjectId     String
  notesMarkdown String?
  extras        Json?
  uiConfig      Json?
  teamId        String?
  type          LectureType           @default(LECTURE)
  checklist     Checklist?
  flashcards    Flashcard[]
  subject       Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  team          MedicalTeam?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  files         LectureFile[]
  records       LectureRecord[]
  videos        LectureVideo[]
  notes         Note[]
  PastPaper     PastPaper?
  questions     Question[]
  activities    UserLectureActivity[]

  @@index([teamId])
}

model Checklist {
  id        String          @id @default(uuid())
  title     String
  lectureId String          @unique
  lecture   Lecture         @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(uuid())
  content     String
  points      Int       @default(1)
  isCritical  Boolean   @default(false)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model Flashcard {
  id        String                  @id @default(uuid())
  front     String
  back      String
  lectureId String
  lecture   Lecture                 @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  progress  UserFlashcardProgress[]

  @@index([lectureId])
}

model UserFlashcardProgress {
  id             String    @id @default(uuid())
  userId         String
  flashcardId    String
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  easeFactor     Float     @default(2.5)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  lastRating     Int?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, nextReviewAt])
}

model LectureFile {
  id                String  @id @default(uuid())
  name              String
  url               String
  mimeType          String
  lectureId         String
  telegramMessageId Int?
  telegramChatId    String?
  telegramFileId    String?
  shouldBroadcast   Boolean @default(true)
  isBroadcasted     Boolean @default(false)
  lecture           Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model LectureVideo {
  id                String                @id @default(uuid())
  title             String
  url               String
  sourceType        MediaSource           @default(EXTERNAL)
  sharingEnabled    Boolean               @default(true)
  likesCount        Int                   @default(0)
  commentsCount     Int                   @default(0)
  sharesCount       Int                   @default(0)
  sortOrder         Int                   @default(0)
  lectureId         String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  telegramMessageId Int?
  telegramChatId    String?
  telegramFileId    String?
  shouldBroadcast   Boolean               @default(true)
  isBroadcasted     Boolean               @default(false)
  startTime         Int?
  endTime           Int?
  isReel            Boolean               @default(false)
  viewCount         Int                   @default(0)
  lecture           Lecture               @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  comments          LectureVideoComment[]
  likes             LectureVideoLike[]
  videoViews        VideoViewTracking[]
  telegramMigrationTasks TelegramMigrationTask[]

  @@index([lectureId, sortOrder])
  @@index([lectureId, createdAt])
}

model LectureRecord {
  id                String   @id @default(uuid())
  title             String
  url               String
  sourceType        MediaSource @default(YOUTUBE)
  lectureId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  telegramMessageId Int?
  telegramChatId    String?
  lecture           Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId, createdAt])
}

model LectureVideoComment {
  id        String                @id @default(uuid())
  content   String
  videoId   String
  userId    String
  createdAt DateTime              @default(now())
  parentId  String?
  parent    LectureVideoComment?  @relation("VideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LectureVideoComment[] @relation("VideoCommentReplies")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     LectureVideo          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model LectureVideoLike {
  id      String       @id @default(uuid())
  videoId String
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   LectureVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
}

model Question {
  id                String             @id @default(uuid())
  body              String
  choices           Json
  answer            String
  explanation       String?
  aiExplanation     String?
  difficulty        DifficultyLevel    @default(MEDIUM)
  lectureId         String
  createdAt         DateTime           @default(now())
  imageUrl          String?
  stemLayout        QuestionStemLayout @default(STANDARD)
  essayReference    String?
  questionType      QuestionTypeV2     @default(MCQ)
  telegramMessageId String?
  telegramChatId    String?
  videoUrl          String?
  videoSource       MediaSource        @default(YOUTUBE)
  stationTime       Int?
  sharedInPosts     Post[]
  lecture           Lecture            @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  reports           QuestionReport[]
  attemptItems      QuizAttemptItem[]
  savedBy           SavedQuestion[]
  studyRoomPosts    StudyRoomPost[]

  @@index([lectureId])
}

model PastPaper {
  id                      String           @id @default(uuid())
  title                   String
  pdfUrl                  String?
  isInteractive           Boolean          @default(false)
  timeLimitMin            Int?
  semesterId              String
  moduleId                String
  createdAt               DateTime         @default(now())
  aiExplanationEnabled    Boolean          @default(true)
  allowAiDuringQuiz       Boolean          @default(false)
  restrictCopyPaste       Boolean          @default(false)
  secureExamMode          Boolean          @default(false)
  trackFocusLoss          Boolean          @default(false)
  kind                    PastPaperKind    @default(MODULE_QUESTION_BANK)
  quizLectureId           String?          @unique
  googleSheetsSyncEnabled Boolean          @default(false)
  isPrivate               Boolean          @default(false)
  randomizeQuestions      Boolean          @default(false)
  module                  Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizLecture             Lecture?         @relation(fields: [quizLectureId], references: [id], onDelete: SetNull)
  semester                Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  questionReports         QuestionReport[]
  attempts                QuizAttempt[]

  @@index([moduleId])
  @@index([semesterId])
}

model QuestionReport {
  id          String     @id @default(uuid())
  questionId  String
  userId      String
  note        String?
  images      String[]
  pastPaperId String?
  createdAt   DateTime   @default(now())
  pastPaper   PastPaper? @relation(fields: [pastPaperId], references: [id], onDelete: SetNull)
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId, createdAt])
  @@index([pastPaperId])
}

model SavedQuestion {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt])
  @@index([questionId])
}

model GuestQuizUser {
  id                String        @id @default(uuid())
  displayName       String
  externalStudentId String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  facultyId         String?
  semesterId        String?
  universityId      String?
  faculty           Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  semester          Semester?     @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  university        University?   @relation(fields: [universityId], references: [id], onDelete: SetNull)
  quizAttempts      QuizAttempt[]

  @@index([createdAt])
}

model QuizAttempt {
  id              String            @id @default(uuid())
  score           Int
  timeTaken       Int               @default(0)
  userId          String?
  pastPaperId     String
  createdAt       DateTime          @default(now())
  focusLossCount  Int               @default(0)
  guestQuizUserId String?
  guestQuizUser   GuestQuizUser?    @relation(fields: [guestQuizUserId], references: [id], onDelete: Cascade)
  pastPaper       PastPaper         @relation(fields: [pastPaperId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           QuizAttemptItem[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([guestQuizUserId])
  @@index([pastPaperId])
}

model StudyAssistantProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  scheduleText      String?
  hobbies           String?
  dailyStudyMinutes Int      @default(120)
  worshipMinutes    Int      @default(30)
  otherRoutines     String?
  currentPlanJson   Json?
  progressJson      Json?
  weekStartIso      String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizAttemptItem {
  id         String      @id @default(uuid())
  chosen     String?
  isCorrect  Boolean
  attemptId  String
  questionId String
  /// AI rubric for ESSAY: scorePercent, stagesMet/Total, feedback, stageNotes
  essayGrade Json?
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([attemptId, isCorrect])
  @@index([questionId])
}

model User {
  id                       String                    @id @default(uuid())
  name                     String
  nickname                 String?
  email                    String                    @unique
  emailVerified            DateTime?
  image                    String?
  bio                      String?
  phone                    String?
  phoneVisible             Boolean                   @default(false)
  hideRank                 Boolean                   @default(false)
  theme                    Theme                     @default(SYSTEM)
  role                     Role                      @default(STUDENT)
  points                   Int                       @default(0)
  password                 String?
  studentId                String?
  universityId             String?
  semesterId               String?
  rankId                   String?
  studentCode              String?                   @unique
  rolePermissions          Json?
  telegramPhone            String?                   @unique
  isLeader                 Boolean                   @default(false)
  leaderId                 String?
  leader                   User?                     @relation("UserLeader", fields: [leaderId], references: [id])
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  facebookUrl              String?
  instagramUrl             String?
  isPrivate                Boolean                   @default(false)
  canManageReports         Boolean                   @default(false)
  facultyId                String?
  personalGeminiKey        String?
  useCustomKey             Boolean                   @default(false)
  personalOpenAIKey        String?
  personalGroqKey          String?
  personalOpenRouterKey    String?
  personalXAIKey           String?
  personalAnthropicKey     String?
  personalSiliconFlowKey   String?
  personalSiliconFlowModel String?                   @default("deepseek-ai/DeepSeek-R1")
  personalCloudflareKey    String?
  personalHuggingfaceKey   String?
  personalTogetherKey      String?
  personalGithubKey        String?
  personalCerebrasKey      String?
  personalMistralKey       String?
  personalSiliconFlowUrl   String?                   @default("https://api.siliconflow.cn/v1")
  handle                   String?                   @unique
  telegramId               String?                   @unique
  telegramVerified         Boolean                   @default(false)
  coverImage               String?
  aiUsageLogs              AIUsageLog[]
  accounts                 Account[]
  auditLogs                AuditLog[]
  channelFollows           ChannelFollow[]

  comments                 Comment[]
  commentLikes             CommentLike[]
  dmReceived               DirectMessage[]           @relation("DmReceived")
  dmSent                   DirectMessage[]           @relation("DmSent")
  documentTemplates        DocumentTemplate[]
  engagementLogs           EngagementLog[]
  videoComments            LectureVideoComment[]
  videoLikes               LectureVideoLike[]
  likes                    Like[]
  reactions                PostReaction[]
  notes                    Note[]
  notifications            Notification[]
  notifMutes               NotificationMute?
  pollVotes                PollVote[]
  posts                    Post[]
  receivedInvites          PrivateForumInvite[]      @relation("InviteReceiver")
  sentInvites              PrivateForumInvite[]      @relation("InviteSender")
  forumMemberships         PrivateForumMember[]
  pushSubscriptions        PushSubscription[]
  questionReports          QuestionReport[]
  quizAttempts             QuizAttempt[]
  savedPosts               SavedPost[]
  savedQuestions           SavedQuestion[]
  sessions                 Session[]
  studyAssistantProfile    StudyAssistantProfile?
  ownedStudyRoom           StudyRoom?                @relation("RoomOwner")
  studyRoomComments        StudyRoomComment[]
  studyRoomMembers         StudyRoomMember[]
  studyRoomPosts           StudyRoomPost[]
  studyRoomPostLikes       StudyRoomPostLike[]
  taskCompletions          StudyRoomTaskCompletion[]
  studySessionsStarted     StudySession[]            @relation("SessionStarter")
  sessionParticipations    StudySessionParticipant[]
  pointsTransactions       UserPointsTransaction[]
  flashcardProgress        UserFlashcardProgress[]
  followedTeams            TeamFollower[]
  teamMemberships          TeamMember[]
  faculty                  Faculty?                  @relation(fields: [facultyId], references: [id])
  rank                     Rank?                     @relation(fields: [rankId], references: [id])
  semester                 Semester?                 @relation(fields: [semesterId], references: [id])
  university               University?               @relation(fields: [universityId], references: [id])
  v2IdentityProviders      IdentityProvider[]
  v2RoleAssignments        UserRoleAssignment[]
  v2TeacherProfile         TeacherProfile?
  v2CourseEnrollments      CourseEnrollment[]
  userLectureActivities    UserLectureActivity[]     @relation("UserLectureActivities")
  followers                UserFollow[]              @relation("UserFollowers")
  following                UserFollow[]              @relation("UserFollows")
  assignedTasks            UserTask[]                @relation("UserTasks")
  v2AuditLogs              V2AuditLog[]              @relation("V2AuditLogs")
  outboxEvents             OutboxEvent[]             @relation("OutboxActor")
  atlasBookmarks           AtlasBookmark[]           @relation("AtlasBookmarks")
  adminAiKeys              AdminAIKeys?
  atlasNotes               AtlasNote[]               @relation("AtlasNotes")
  hideOnlineStatus         Boolean                   @default(false)
  lastSeenAt               DateTime?
  ownedGroup               Group?                    @relation("GroupOwner")
  groupMemberships         GroupMember[]
  groupJoinRequests        GroupJoinRequest[]
  reports                  Report[]
  reportActions            ReportAction[]
  blocks                   BlockedUser[]             @relation("UserBlocks")
  blockedBy                BlockedUser[]             @relation("UserBlocked")
  testimonials             Testimonial[]
  reviewedTestimonials     Testimonial[]             @relation("TestimonialReviewer")
  createdForums            Forum[]
  sharedResources          LibraryResource[]
  sharedQuizAttempts       SharedQuizAttempt[]
  lastLoginAt              DateTime?
  lastActivityAt           DateTime?
  totalSessionSeconds      Int                       @default(0)
  warningCount             Int                       @default(0)
  isBanned                 Boolean                   @default(false)
  bannedAt                 DateTime?
  banReason                String?
  warnings                 Warning[]                 @relation("UserWarnings")
  issuedWarnings           Warning[]                 @relation("IssuedWarnings")
  revokedWarnings          Warning[]                 @relation("RevokedWarnings")
  adminActionLogs          AdminActionLog[]
  securityEvents           SecurityEvent[]
  securityResolutions      SecurityEvent[]           @relation("SecurityResolution")
  sessionLogs              UserSessionLog[]
  pageViews                PageView[]
  videoViews               VideoViewTracking[]
  ledTeam                  User[]                    @relation("UserLeader")

  @@index([leaderId])
}

model TelegramConfig {
  id               String   @id @default("global")
  welcomeMessage   String?
  broadcastMessage String?
  botStatus        String   @default("ACTIVE")
  defaultProvider  String   @default("gemini")
  defaultModel     String?
  updatedAt        DateTime @updatedAt
}

model BotAuth {
  id         String   @id @default(uuid())
  code       String   @unique
  telegramId String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  content   String
  lectureId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([lectureId])
  @@index([userId])
}

model UserLectureActivity {
  id           String   @id @default(uuid())
  userId       String
  lectureId    String
  source       String?
  lastViewedAt DateTime @default(now())
  isCompleted  Boolean  @default(false)
  lecture      Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user         User     @relation("UserLectureActivities", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId, lastViewedAt])
  @@index([lectureId])
}

model DirectMessage {
  id         String   @id @default(uuid())
  body       String
  read       Boolean  @default(false)
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  receiver   User     @relation("DmReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("DmSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId, read])
  @@index([senderId, receiverId, createdAt])
}

model Forum {
  id           String               @id @default(uuid())
  name         String
  type         ForumType
  status       ForumStatus          @default(OPEN)
  semesterId   String?
  createdBy    String?
  creator      User?                @relation(fields: [createdBy], references: [id])
  createdAt    DateTime             @default(now())
  universityId String
  semester     Semester?            @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  university   University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  posts        Post[]
  invites      PrivateForumInvite[]
  members      PrivateForumMember[]

  @@index([universityId, type, status])
}

model PrivateForumMember {
  id      String @id @default(uuid())
  forumId String
  userId  String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)
