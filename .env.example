# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/medqs
# Neon:    postgresql://user:pass@ep-xxx.aws.neon.tech/medqs?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/medqs"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://default:xxx@global.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Facebook OAuth ───────────────────────────────────────────────────────────
# https://developers.facebook.com → Create App → Facebook Login
# Redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── Google Gemini AI (FREE — no billing required) ───────────────────────────
# Get free API key: https://aistudio.google.com/app/apikey
# Free tier: 1,500 req/day · 1M tokens/day · 15 RPM — no credit card needed
# Model used: gemini-2.0-flash-exp
GEMINI_API_KEY=""

# ─── File Storage (Cloudflare R2 or AWS S3) ───────────────────────────────────
# Used for: lecture files, past paper PDFs, profile avatars, ad images

# Cloudflare R2:
#   Endpoint: https://<account-id>.r2.cloudflarestorage.com
#   Region:   auto
#   Keys: R2 API token with Object Read & Write permission
#
# AWS S3:
#   Endpoint: leave blank (AWS uses default)
#   Region:   e.g. us-east-1
#   Keys: IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject
S3_BUCKET="medqs-uploads"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""         # For R2: https://<account-id>.r2.cloudflarestorage.com
                       # For AWS: leave blank

# Public base URL for serving uploaded files
# For R2 with custom domain:  https://assets.yourdomain.com
# For R2 public bucket:       https://pub-<hash>.r2.dev
# For AWS S3 (public bucket): leave blank (auto-constructed)
S3_PUBLIC_URL=""

# ─── Google Sheets (optional — admin export feature) ──────────────────────────
# 1. Create service account in Google Cloud Console
# 2. Download JSON key file
# 3. Share your spreadsheet with the service account email
# 4. Paste entire JSON as single-line string
GOOGLE_SHEETS_SERVICE_ACCOUNT=""   # {"type":"service_account","project_id":"...","private_key":"...",...}
GOOGLE_SHEETS_SPREADSHEET_ID=""    # From the spreadsheet URL: /d/<ID>/edit

# ─── Uploadthing (FREE file storage — no credit card) ─────────────────────────
# https://uploadthing.com → Create App → API Keys
# Free tier: 2GB storage, no credit card needed
# Use this instead of S3/R2 while testing
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ─── Bcrypt (for Email/Password auth) ─────────────────────────────────────────
# No extra config needed — bcryptjs is built-in
# Users register at /register with email + studentId + password
