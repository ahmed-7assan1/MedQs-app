  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next','node_modules/.cache']) { try { fs.rmSync(p,{recursive:true,force:true}); console.log('Removed', p); } catch (_) {} }\"",
    "dev:clean": "npm run clean && next dev",
    "dev:turbo": "next dev --turbo",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "npx vercel --prod",
    "deploy:preview": "npx vercel",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:sync": "prisma db push && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
